"""Run explicitly against a disposable PostgreSQL instance."""

from __future__ import annotations

import asyncio
import os

from httpx import ASGITransport, AsyncClient
from pytest import MonkeyPatch

from {{ packageName }}.app import create_app


def test_real_database_readiness(monkeypatch: MonkeyPatch) -> None:
    """A reachable required database must produce positive readiness."""
    monkeypatch.setenv("DATABASE_URL", os.environ["TEST_DATABASE_URL"])
    application = create_app()

    async def exercise() -> None:
        async with application.router.lifespan_context(application):
            transport = ASGITransport(app=application)
            async with AsyncClient(
                transport=transport, base_url="http://test"
            ) as client:
                response = await client.get("/health/ready")
                assert response.status_code == 200
                assert response.json() == {"status": "ready"}
        assert not hasattr(application.state, "resources")

    asyncio.run(exercise())
