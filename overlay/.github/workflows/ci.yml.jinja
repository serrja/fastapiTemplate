name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: {% raw %}ci-${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
{% if withPersistence %}    services:
      postgres:
        image: postgres:17.11-trixie@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3
        env:
          POSTGRES_USER: foundation
          POSTGRES_PASSWORD: synthetic-test-only
          POSTGRES_DB: foundation
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U foundation -d foundation"
          --health-interval 2s --health-timeout 2s --health-retries 30
    env:
      TEST_DATABASE_URL: postgresql+asyncpg://foundation:synthetic-test-only@127.0.0.1:5432/foundation
{% endif %}    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@5a7eac68fb9809dea845d802897dc5c723910fa3 # v7.1.3
        with:
          version: "0.12.15"
          enable-cache: true
          cache-dependency-glob: uv.lock
      - uses: ./.github/actions/actionlint
      - run: uv python install {{ pythonVersion | default('3.12') }}
      - name: Locked quality, tests and coverage
        run: |
          uv sync --locked --python {{ pythonVersion | default('3.12') }}
          make check
{% if withDocker %}      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1
      - name: Test environment; stable cache scope per PR or main
        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0
        with:
          context: .
          target: test
          load: true
          tags: {{ packageName }}:test
          cache-from: {% raw %}type=gha,scope=${{ github.repository_id }}-test-linux-amd64-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.number) || 'main' }}{% endraw %}
          cache-to: {% raw %}type=gha,mode=max,scope=${{ github.repository_id }}-test-linux-amd64-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.number) || 'main' }}{% endraw %}
      - name: Fresh installed-wheel container tests{% if withPersistence %} with disposable PostgreSQL{% endif %}
        run: make test-image
      - name: Runtime from the same wheel
        uses: docker/build-push-action@263435318d21b8e681c14492fe198d362a7d2c83 # v6.18.0
        with:
          context: .
          target: runtime
          load: true
          tags: {{ packageName }}:candidate
          cache-from: |
            {% raw %}type=gha,scope=${{ github.repository_id }}-test-linux-amd64-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.number) || 'main' }}{% endraw %}
            {% raw %}type=gha,scope=${{ github.repository_id }}-runtime-linux-amd64-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.number) || 'main' }}{% endraw %}
          cache-to: {% raw %}type=gha,mode=max,scope=${{ github.repository_id }}-runtime-linux-amd64-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.number) || 'main' }}{% endraw %}
{% endif %}      - run: make build
{% if withKubernetes %}      - uses: ./.github/actions/deployment-tools
      - run: make chart-check chart
{% endif %}{% if withDocker and withKubernetes %}      - name: Disposable Kubernetes acceptance of the loaded image
        env:
          KUBECONFIG: {% raw %}${{ runner.temp }}/foundation-kubeconfig{% endraw %}
        run: |
          set -euo pipefail
          make deploy-local KUBECONFIG_LOCAL="$KUBECONFIG"
          trap 'make undeploy-local' EXIT
          kubectl --context kind-{{ packageName }}-local -n foundation rollout status deployment/{{ packageName }} --timeout=120s
          kubectl --context kind-{{ packageName }}-local -n foundation port-forward service/{{ packageName }} 18080:8000 > "$RUNNER_TEMP/port-forward.log" 2>&1 &
          curl --fail --silent --show-error --retry 15 --retry-connrefused --retry-delay 1 http://127.0.0.1:18080/health/ready
          helm upgrade {{ packageName }} deploy/chart --kube-context kind-{{ packageName }}-local --namespace foundation --reuse-values --set replicaCount=3 --wait --timeout 120s --rollback-on-failure
          helm rollback {{ packageName }} 1 --kube-context kind-{{ packageName }}-local --namespace foundation --wait --timeout 120s
{% endif %}{% if withDocker %}      - name: Preserve the tested local image identity and archive
        run: |
          docker image inspect {{ packageName }}:candidate > dist/runtime-image.json
          docker save {{ packageName }}:candidate | gzip --no-name > dist/runtime-image.docker.tar.gz
          find dist -maxdepth 1 -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > dist/SHA256SUMS
{% endif %}      - name: Artifact and coverage evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: verified-candidate
          path: |
            coverage/
            dist/
          if-no-files-found: error
  required:
    if: always()
    needs: [verify]
    runs-on: ubuntu-24.04
    timeout-minutes: 2
    steps:
      - env:
          VERIFY_RESULT: {% raw %}${{ needs.verify.result }}{% endraw %}
        run: test "$VERIFY_RESULT" = success
