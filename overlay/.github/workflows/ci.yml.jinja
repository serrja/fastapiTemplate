name: CI

on:
  push:
  pull_request:

permissions:
  contents: read

concurrency:
  group: {% raw %}ci-${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: astral-sh/setup-uv@5a7eac68fb9809dea845d802897dc5c723910fa3 # v7.1.3
        with:
          version: "0.12.15"
          enable-cache: true
          cache-dependency-glob: uv.lock
      - run: uv python install 3.12
      - run: uv lock --check
      - run: uv sync --locked --python 3.12
      - run: uv run --locked ruff check .
      - run: uv run --locked ruff format --check .
      - run: uv run --locked mypy
      - name: Existing tests
        if: {% raw %}hashFiles('tests/test_*.py', 'tests/**/test_*.py') != ''{% endraw %}
        run: uv run --locked pytest
      - name: Test status
        if: {% raw %}hashFiles('tests/test_*.py', 'tests/**/test_*.py') == ''{% endraw %}
        run: |
          echo 'NOT_CONFIGURED: no subject tests yet'
      - run: uv build
      - name: Installed wheel import outside source
        run: |
          uv venv "$RUNNER_TEMP/wheelCheck" --python 3.12
          uv pip install --python "$RUNNER_TEMP/wheelCheck/bin/python" dist/*.whl
          cd "$RUNNER_TEMP"
          "$RUNNER_TEMP/wheelCheck/bin/python" -c 'from {{ packageName }}.app import create_app; print(create_app().title)'
{% if withDocker %}      - name: Container build
        run: docker build --file Dockerfile --tag {{ packageName | lower }}:ci .
{% endif %}
