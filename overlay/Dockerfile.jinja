# syntax=docker/dockerfile:1.27.1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
ARG PYTHON_IMAGE={{ pythonImage | default('python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e') }}

{% block extraBuildStages %}{% endblock %}FROM ghcr.io/astral-sh/uv:0.12.15@sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3 AS uv

FROM ${PYTHON_IMAGE} AS base
ARG TARGETPLATFORM
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

FROM base AS dependencies
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock README.md .gitignore THIRD_PARTY_NOTICES.md ./
COPY LICENSES ./LICENSES
{% if licensePolicy | default('unlicensed') == 'MIT' %}COPY LICENSE ./
{% endif %}
{% block dependencyAcquisition %}RUN --mount=type=cache,id={{ packageName }}-runtime-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked \
    uv sync --locked --no-dev --no-install-project
{% endblock %}
FROM dependencies AS wheel-builder
{% block testDependencies %}RUN --mount=type=cache,id={{ packageName }}-development-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked \
    uv sync --locked --all-groups --no-install-project
{% endblock %}COPY src ./src
RUN --mount=type=cache,id={{ packageName }}-build-${TARGETPLATFORM},target=/root/.cache/uv,sharing=locked \
    uv build --no-build-isolation --wheel --sdist --out-dir /dist

FROM wheel-builder AS quality
RUN apt-get update && apt-get install -y --no-install-recommends make git curl ca-certificates && rm -rf /var/lib/apt/lists/*
{% if withKubernetes %}RUN curl --fail --silent --show-error --location https://get.helm.sh/helm-v4.3.1-linux-amd64.tar.gz --output /tmp/helm.tar.gz \
    && echo '0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b  /tmp/helm.tar.gz' | sha256sum --check --status \
    && tar -xzf /tmp/helm.tar.gz -C /tmp linux-amd64/helm && mv /tmp/linux-amd64/helm /usr/local/bin/helm && rm -rf /tmp/helm.tar.gz /tmp/linux-amd64
{% endif %}RUN uv pip install --python /app/.venv/bin/python --no-deps /dist/*.whl
COPY --chmod=u=rwX,go=rX . ./
ENV CONTAINERIZED=1 UV_NO_SYNC=1
CMD ["make", "check"]

FROM scratch AS artifacts
COPY --from=wheel-builder /dist/ /

FROM dependencies AS installed
COPY --from=wheel-builder /dist/*.whl /wheels/
RUN uv pip install --python /app/.venv/bin/python --no-deps /wheels/*.whl

{% if withTesting %}FROM wheel-builder AS test
RUN uv pip install --python /app/.venv/bin/python --no-deps /dist/*.whl
WORKDIR /checks
COPY --exclude=src --exclude=src/** --chmod=u=rwX,go=rX . ./
ENV COVERAGE_FILE=/checks/coverage/.coverage TEST_INSTALLED_WHEEL=1
USER 65532:65532
CMD ["python", "-m", "pytest", "--cov", "--cov-report=term-missing", "--cov-report=json", "--cov-report=xml", "-p", "no:cacheprovider"]

{% endif %}FROM base AS runtime
COPY --from=installed /app/.venv /app/.venv
COPY --chmod=u=rwX,go=rX --from=dependencies /app/LICENSES /licenses/scaffold
COPY --chmod=0444 --from=dependencies /app/THIRD_PARTY_NOTICES.md /licenses/THIRD_PARTY_NOTICES.md
{% if licensePolicy | default('unlicensed') == 'MIT' %}COPY --chmod=0444 --from=dependencies /app/LICENSE /licenses/LICENSE
LABEL org.opencontainers.image.licenses="MIT"
{% endif %}COPY --chmod=u=rw,go=r app_logging.json ./app_logging.json
{% if withPersistence %}COPY --chmod=u=rwX,go=rX migrations ./migrations
COPY --chmod=u=rwX,go=rX alembic.ini ./
{% endif %}ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
USER 65532:65532
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.build_opener(urllib.request.ProxyHandler({})).open('http://127.0.0.1:8000/health/live', timeout=2).close()"]
CMD ["python", "-m", "uvicorn", "{{ packageName }}.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-access-log", "--log-config", "/app/app_logging.json", "--workers", "1", "--timeout-graceful-shutdown", "10"]
