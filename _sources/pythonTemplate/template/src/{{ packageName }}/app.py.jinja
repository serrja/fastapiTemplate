"""Compose the generic service and own its process resources."""

from __future__ import annotations

import logging
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

from fastapi import FastAPI
{% if withPersistence | default(false) %}from sqlalchemy.ext.asyncio import AsyncEngine
{% endif %}
from {{ packageName }}.health import router as health_router
{% if withPersistence | default(false) %}from {{ packageName }}.persistence import create_engine
