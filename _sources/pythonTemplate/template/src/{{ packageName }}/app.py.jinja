@asynccontextmanager
async def lifespan(application: FastAPI) -> AsyncIterator[None]:
    """Own process resources for exactly one ASGI lifespan."""
    settings = ServiceSettings()
    logging.getLogger("{{ projectName }}").setLevel(settings.logLevel)
{% if withPersistence | default(false) %}    engine = createEngine(settings)
    application.state.dbEngine = engine
    try:
        yield
    finally:
        await engine.dispose()
{% else %}    yield
{% endif %}

app = FastAPI(title="{{ projectName }}", lifespan=lifespan)


