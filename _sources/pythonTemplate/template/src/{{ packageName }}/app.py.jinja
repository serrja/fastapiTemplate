def create_app(settings: ServiceSettings | None = None) -> FastAPI:
    """Construct a service without opening network resources at import time."""

    @asynccontextmanager
    async def lifespan(application: FastAPI) -> AsyncIterator[None]:
        """Release enabled resources even when startup fails."""
        resolved_settings = settings if settings is not None else ServiceSettings()
        logging.getLogger("{{ projectName }}").setLevel(resolved_settings.log_level)
{% if withPersistence | default(false) %}        engine: AsyncEngine | None = None
        try:
            engine = create_engine(resolved_settings)
            application.state.db_engine = engine
            yield
        finally:
            if hasattr(application.state, "db_engine"):
                del application.state.db_engine
            if engine is not None:
                await engine.dispose()
{% else %}        yield
{% endif %}
    application = FastAPI(title="{{ projectName }}", lifespan=lifespan)
    application.include_router(health_router)
    return application


app = create_app()
