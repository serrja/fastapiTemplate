name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: {% raw %}ci-${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: ./.github/actions/actionlint
      - uses: astral-sh/setup-uv@5a7eac68fb9809dea845d802897dc5c723910fa3 # v7.1.3
        with:
          version: "0.12.15"
          enable-cache: true
          cache-dependency-glob: uv.lock
      - run: uv python install 3.12
      - run: uv lock --check
      - run: uv sync --locked --python 3.12
      - run: uv run --locked ruff check .
      - run: uv run --locked ruff format --check .
      - run: uv run --locked mypy
{% if withTesting | default(true) %}      - name: Tests and complete Python coverage
        run: make test
      - name: Coverage evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: python-coverage
          path: coverage/
          if-no-files-found: error
{% else %}      - name: Testing capability omitted by render answers
        run: echo 'NOT_APPLICABLE - withTesting=false'
{% endif %}
      - run: make build
{% if profile == 'service' %}      - run: docker build --file Dockerfile --tag {{ packageName }}:ci .
      - run: uv run --locked python -c 'from {{ packageName }}.app import app; print(app.title)'
{% endif -%}
