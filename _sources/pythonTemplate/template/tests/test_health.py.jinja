"""Verify infrastructure HTTP behavior with an explicit ASGI lifespan."""

from __future__ import annotations

import asyncio

from httpx import ASGITransport, AsyncClient
{% if withPersistence | default(false) %}from pytest import MonkeyPatch
{% endif %}
from {{ packageName }}.app import create_app


def test_liveness_and_missing_route({% if withPersistence | default(false) %}monkeypatch: MonkeyPatch{% endif %}) -> None:
    """Liveness does not require a database connection or product routes."""
{% if withPersistence | default(false) %}    monkeypatch.setenv(
        "DATABASE_URL", "postgresql+asyncpg://test:test@127.0.0.1:1/test"
    )
{% endif %}
    async def exercise() -> None:
        application = create_app()
        async with application.router.lifespan_context(application):
            transport = ASGITransport(app=application)
            async with AsyncClient(
                transport=transport, base_url="http://test"
            ) as client:
                assert (await client.get("/health/live")).json() == {"status": "alive"}
                assert (await client.get("/missing")).status_code == 404
{% if not (withPersistence | default(false)) %}                assert (await client.get("/health/ready")).json() == {"status": "ready"}
{% endif %}
    asyncio.run(exercise())
