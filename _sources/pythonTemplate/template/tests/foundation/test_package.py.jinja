"""Verify the installed distribution and deliberate root package boundary."""

from __future__ import annotations

import importlib
from importlib.metadata import distribution


def test_installed_distribution_and_public_import() -> None:
    package = importlib.import_module("{{ packageName }}")
    installed = distribution("{{ distributionName | default(packageName) }}")
    assert installed.metadata["Name"] == "{{ distributionName | default(packageName) }}"
    assert installed.version
    assert package.__name__ == "{{ packageName }}"
