@pytest.mark.parametrize("execution", EXECUTION)
@pytest.mark.parametrize("deployment", DEPLOYMENT)
def test_all_sixteen_independent_pairs(context, monkeypatch, execution, deployment):
    runtime, telemetry, options = context
    monkeypatch.setenv(PREFIX + "ENVIRONMENT", execution)
    monkeypatch.setenv(PREFIX + "RUNTIME_ENVIRONMENT", deployment)
    assert runtime(_env_file=None, **options).environment == deployment
    assert telemetry.ObservabilitySettings(_env_file=None).environment == execution


