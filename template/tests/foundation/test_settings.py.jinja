def test_constructor_priority_and_serialization(context, monkeypatch):
    runtime, telemetry, options = context
    monkeypatch.setenv(PREFIX + "ENVIRONMENT", "ci")
    monkeypatch.setenv(PREFIX + "RUNTIME_ENVIRONMENT", "dev")
    value = runtime(_env_file=None, environment="main", **options)
    assert value.environment == "main"
    assert value.model_dump()["environment"] == "main"
    assert value.model_dump(by_alias=True)["environment"] == "main"
    assert telemetry.ObservabilitySettings(_env_file=None).environment == "ci"


def test_explicit_constructor_alias_and_telemetry_constructor(context):
    runtime, telemetry, options = context
    assert (
        runtime(**{PREFIX + "RUNTIME_ENVIRONMENT": "test"}, **options).environment
        == "test"
    )
    for execution in EXECUTION:
        assert (
            telemetry.ObservabilitySettings(environment=execution).environment
            == execution
        )


def test_native_source_precedence(context, monkeypatch, tmp_path):
    runtime, _, options = context
    dotenv = tmp_path / "synthetic.env"
    dotenv.write_text(PREFIX + "RUNTIME_ENVIRONMENT=test\n")
    secret = tmp_path / "synthetic-secrets"
    secret.mkdir()
    (secret / (PREFIX + "RUNTIME_ENVIRONMENT")).write_text("dev")
    selected = dict(_env_file=dotenv, _secrets_dir=secret, **options)
    monkeypatch.setenv(PREFIX + "ENVIRONMENT", "ci")
    monkeypatch.setenv(PREFIX + "RUNTIME_ENVIRONMENT", "main")
    assert runtime(environment="local", **selected).environment == "local"
    assert runtime(**selected).environment == "main"
    monkeypatch.delenv(PREFIX + "RUNTIME_ENVIRONMENT")
    assert runtime(**selected).environment == "test"
    dotenv.write_text("")
    assert runtime(**selected).environment == "dev"


@pytest.mark.parametrize("execution", ["ci", "remote"])
@pytest.mark.parametrize("source", ["dotenv", "secret"])
def test_legacy_external_sources_only_set_telemetry(
    context, tmp_path, execution, source
):
    runtime, telemetry, options = context
    if source == "dotenv":
        file = tmp_path / "synthetic.env"
        file.write_text(PREFIX + "ENVIRONMENT=" + execution + "\n")
        selected = {"_env_file": file}
    else:
        directory = tmp_path / "synthetic-secrets"
        directory.mkdir()
        (directory / (PREFIX + "ENVIRONMENT")).write_text(execution)
        selected = {"_secrets_dir": directory}
    assert runtime(**selected, **options).environment == "local"
    assert telemetry.ObservabilitySettings(**selected).environment == execution


@pytest.mark.parametrize("value", ["ci", "remote", "SYNTHETIC_BAD_RUNTIME"])
@pytest.mark.parametrize("source", ["init", "env", "dotenv", "secret"])
def test_invalid_runtime_sources_fail_safely(
    context, monkeypatch, tmp_path, value, source
):
    runtime, _, options = context
    selected = dict(options)
    if source == "init":
        selected["environment"] = value
    elif source == "env":
        monkeypatch.setenv(PREFIX + "RUNTIME_ENVIRONMENT", value)
    elif source == "dotenv":
        file = tmp_path / "synthetic.env"
        file.write_text(PREFIX + "RUNTIME_ENVIRONMENT=" + value + "\n")
        selected["_env_file"] = file
    else:
        directory = tmp_path / "synthetic-secrets"
        directory.mkdir()
        (directory / (PREFIX + "RUNTIME_ENVIRONMENT")).write_text(value)
        selected["_secrets_dir"] = directory
    with pytest.raises(ValidationError) as error:
        runtime(**selected)
    assert "SYNTHETIC_BAD_RUNTIME" not in str(error.value)


