def test_database_aliases_and_validation_remain_unchanged(context, monkeypatch):
    runtime, _, options = context
    if options:
        with pytest.raises(ValidationError):
            runtime()
        monkeypatch.setenv(PREFIX + "DATABASE_URL", DSN)
        assert runtime().database_url.get_secret_value() == DSN
        monkeypatch.delenv(PREFIX + "DATABASE_URL")
        monkeypatch.setenv("DATABASE_URL", DSN)
        assert runtime().database_url.get_secret_value() == DSN
        with pytest.raises(ValidationError):
            runtime(database_url="sqlite://synthetic")
    else:
        assert "database_url" not in runtime.model_fields


@pytest.mark.parametrize("execution", EXECUTION)
def test_native_request_formatter_retains_execution_contour(
    context, monkeypatch, execution
):
    runtime, telemetry, options = context
    monkeypatch.setenv(PREFIX + "ENVIRONMENT", execution)
    monkeypatch.setenv(PREFIX + "RUNTIME_ENVIRONMENT", "main")
    assert runtime(**options).environment == "main"
    formatter = telemetry.RequestFormatter()
    record = logging.LogRecord("probe", logging.INFO, __file__, 1, "probe", (), None)
    assert json.loads(formatter.format(record))["environment"] == execution
