    runtime, telemetry, options = context
    monkeypatch.setenv("ENVIRONMENT", "SYNTHETIC_FOREIGN")
    monkeypatch.setenv("RUNTIME_ENVIRONMENT", "SYNTHETIC_FOREIGN")
