def test_readiness_queries_the_connection(
    application: FastAPI, client: TestClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    statements: list[str] = []

    class Connection:
        async def execute(self, statement: TextClause) -> None:
            statements.append(str(statement))

    @asynccontextmanager
    async def connect(engine: AsyncEngine) -> AsyncIterator[Connection]:
        assert isinstance(engine, AsyncEngine)
        yield Connection()

    monkeypatch.setattr(AsyncEngine, "connect", connect)
    assert client.get("/health/ready").json() == {"status": "ready"}
    assert statements == ["SELECT 1"]
    assert application.state.resources.session_factory.kw["expire_on_commit"] is False


@pytest.mark.parametrize("outcome", ["commit", "rollback", "cancel"])
def test_session_owns_its_transaction(application: FastAPI, outcome: str) -> None:
    async def exercise() -> None:
        async with application.router.lifespan_context(application):
            request = Request({"type": "http", "app": application})
            generator = open_session(request)
            session = await anext(generator)
            events: list[str] = []
            event.listen(
                session.sync_session,
                "after_commit",
                lambda _: events.append("commit"),
            )
            event.listen(
                session.sync_session,
                "after_rollback",
                lambda _: events.append("rollback"),
            )
            assert session.in_transaction()
            if outcome == "commit":
                with pytest.raises(StopAsyncIteration):
                    await anext(generator)
            else:
                error = (
                    asyncio.CancelledError() if outcome == "cancel" else RuntimeError()
                )
                with pytest.raises(type(error)):
                    await generator.athrow(error)
            assert not session.in_transaction()
            assert events == ["commit" if outcome == "commit" else "rollback"]
        assert not hasattr(application.state, "resources")

    asyncio.run(exercise())
