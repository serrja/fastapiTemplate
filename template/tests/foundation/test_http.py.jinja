def test_partial_startup_disposes_the_acquired_engine(
    application: FastAPI, monkeypatch: pytest.MonkeyPatch
) -> None:
    disposed: list[AsyncEngine] = []
    original = AsyncEngine.dispose

    async def dispose(engine: AsyncEngine) -> None:
        disposed.append(engine)
        await original(engine)

    def fail(engine: AsyncEngine) -> None:
        raise RuntimeError("synthetic factory failure")

    monkeypatch.setattr(AsyncEngine, "dispose", dispose)
    monkeypatch.setattr(app_module, "session_factory", fail)
    with pytest.raises(RuntimeError, match="synthetic factory failure"):
        with TestClient(application):
            pytest.fail("A failed session factory must prevent startup")
    assert len(disposed) == 1
    assert not hasattr(application.state, "resources")


