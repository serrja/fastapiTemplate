{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "localDevelopment", "replicaCount", "database", "migration"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 32},
    "localDevelopment": {"type": "boolean"},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "digest", "tag"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:_-]*$"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "tag": {"type": "string", "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "secretName", "secretKey"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "command", "activeDeadlineSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 10, "maximum": 600}
      }
    },
    "resources": {"type": "object", "required": ["requests", "limits"], "additionalProperties": false, "properties": {"requests": {"type": "object", "required": ["cpu", "memory"]}, "limits": {"type": "object", "required": ["cpu", "memory"]}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["port"], "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}}
  }
}
