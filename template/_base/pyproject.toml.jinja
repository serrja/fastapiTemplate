{% block buildSystem %}[build-system]
{% if profile == 'native' %}requires = ["scikit-build-core>=0.11,<1", "pybind11>=3,<4"]
build-backend = "scikit_build_core.build"
{% else %}requires = ["hatchling>=1.27,<2"]
build-backend = "hatchling.build"
{% endif %}{% endblock %}
{% block project %}[project]
name = "{{ packageName | lower }}"
version = "0.1.0"
description = "{{ projectDescription | default(projectName ~ ' ' ~ profile ~ ' foundation') }}"
readme = "README.md"
requires-python = ">={{ pythonMinimum | default('3.12') }}"
dependencies = [{% block runtimeDependencies %}{% if profile == 'cli' %}"typer>=0.27,<1"{% elif profile == 'service' %}"fastapi>=0.119,<1", "uvicorn>=0.38,<1", "pydantic-settings>=2.12,<3"{% if withPersistence | default(false) %}, "sqlalchemy[asyncio]>=2.0.44,<3", "asyncpg>=0.31,<1", "alembic>=1.17,<2"{% endif %}{% endif %}{% endblock %}]
{% endblock %}
{% block scripts %}{% if profile == 'cli' %}[project.scripts]
{{ projectName }} = "{{ packageName }}.cli:app"
{% endif %}{% endblock %}
{% block development %}[dependency-groups]
dev = ["mypy>=2.3,<3", "ruff>=0.16,<1"{% if withTesting | default(true) %}, "pytest>=9,<10", "pytest-cov>=7,<8"{% endif %}]
{% endblock %}
{% block buildTarget %}{% if profile != 'native' %}[tool.hatch.build.targets.wheel]
packages = ["src/{{ packageName }}"]
{% else %}[tool.scikit-build]
wheel.packages = ["src/{{ packageName }}"]
{% endif %}{% endblock %}
{% block quality %}[tool.ruff]
target-version = "{{ ruffTarget | default('py312') }}"
line-length = 100

[tool.ruff.lint]
select = ["B", "E", "F", "I", "RUF", "UP"]

[tool.mypy]
python_version = "{{ pythonMinimum | default('3.12') }}"
strict = true
files = ["src/{{ packageName }}"]{% if withTesting | default(true) %}

[tool.pytest.ini_options]
addopts = "--strict-markers --strict-config"
markers = ["unit: isolated unit tests", "integration: external dependency tests", "contract: public contract tests"]{% endif %}{% endblock %}{% block extraConfiguration %}{% endblock %}
