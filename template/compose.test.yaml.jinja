services:
  database:
    image: postgres:17.11-trixie@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3
    environment:
      POSTGRES_USER: foundation
      POSTGRES_PASSWORD: synthetic-test-only
      POSTGRES_DB: foundation
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U foundation -d foundation"]
      interval: 2s
      timeout: 2s
      retries: 30
  tests:
    image: {{ packageName }}:test
    pull_policy: never
    depends_on:
      database:
        condition: service_healthy
    read_only: true
    user: "${TEST_UID:-65532}:${TEST_GID:-65532}"
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    volumes:
      - ./coverage/installed:/checks/coverage
    environment:
      TEST_DATABASE_URL: postgresql+asyncpg://foundation:synthetic-test-only@database:5432/foundation
    command:
      - /bin/sh
      - -ec
      - >-
        python -m coverage run -m pytest tests/foundation/database_integration.py tests/*_integration.py -p no:cacheprovider
        && python -m pytest --cov --cov-append --cov-report=term-missing --cov-report=json --cov-report=xml -p no:cacheprovider
